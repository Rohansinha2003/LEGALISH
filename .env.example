# Environment Variables — LegalSaathi

# === Database ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/legalsaathi

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# === Auth ===
AUTH_SECRET=your-secret-key-at-least-32-chars

# === LLM Provider ===
LLM_PROVIDER=openai                          # openai | mock
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_API_BASE=https://api.openai.com/v1

# === Embedding Provider ===
EMBEDDING_PROVIDER=openai                    # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# === OCR Provider ===
OCR_PROVIDER=tesseract                       # tesseract | mock

# === Storage ===
STORAGE_PROVIDER=supabase                    # supabase | local
STORAGE_BUCKET=documents
STORAGE_ENDPOINT=

# === File Upload ===
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,docx,png,jpg,jpeg

# === Application ===
ENVIRONMENT=development                      # development | production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# === Frontend (Next.js — prefix with NEXT_PUBLIC_ for client-side) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
